[Unit]
Description=StudyTube API
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@APP_DIR@
EnvironmentFile=-@APP_DIR@/.env
EnvironmentFile=-@APP_DIR@/api/.env
Environment=API_SOCKET_PATH=/run/studytube/api.sock
RuntimeDirectory=studytube
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/bin/rm -f /run/studytube/api.sock
ExecStart=/usr/bin/env NODE_ENV=production AUTH_TRUST_PROXY_ONE_HOP=true COURSE_CUTOVER_MODE=@COURSE_CUTOVER_MODE@ @NODE_BIN@ api/dist/src/main.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
