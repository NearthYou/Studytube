[Unit]
Description=StudyTube AI service
After=network-online.target docker.service studytube-deploy-resume.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@AI_USER@
Group=@AI_USER@
SupplementaryGroups=@SOCKET_GROUP@ @RUNTIME_GROUP@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@RUNTIME_CONFIG_DIR@/ai.env
Environment=NODE_ENV=production
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=STUDYTUBE_API_SOCKET_PATH=/run/studytube/api.sock
ExecStart=@APP_DIR@/ai/.venv/bin/python -m uvicorn main:app --app-dir @APP_DIR@/ai --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
IPAddressDeny=169.254.169.254/32
IPAddressDeny=fd00:ec2::254/128

[Install]
WantedBy=multi-user.target
