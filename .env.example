# Shared
NODE_ENV=development

# Frontend
VITE_API_BASE_URL=http://localhost:3000
VITE_KAKAO_MAP_JS_KEY=

# Backend
PORT=3000
DATABASE_URL=postgres://tailtalk:tailtalk@localhost:5432/tailtalk
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=3600
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Tail Talk <noreply@example.com>"

# Social auth (optional in development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
SOCIAL_AUTH_BACKEND_URL=http://localhost:3000
SOCIAL_AUTH_FRONTEND_URL=http://localhost:5173
SOCIAL_AUTH_TIMEOUT_MS=10000

# TourAPI / Pet places
TOUR_API_SERVICE_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorPetTourService2
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=TailTalk
TOUR_API_TIMEOUT_MS=10000

# Assistant / AI worker
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-5.5

# Live smoke release gate (manual opt-in; do not commit real secrets)
RUN_LIVE_SMOKE=false
LIVE_SMOKE_TARGETS=frontend,backend,auth,agent,crud,upload,tourapi,kakao-map,ai,openai
LIVE_SMOKE_FRONTEND_URL=http://localhost:5173
LIVE_SMOKE_BACKEND_URL=http://localhost:3000
LIVE_SMOKE_AI_URL=http://localhost:8000
LIVE_SMOKE_UPLOAD_READ_URL=http://localhost:3000
LIVE_SMOKE_SECONDARY_BACKEND_URL=
LIVE_SMOKE_FAIL_ON_SKIP=false
LIVE_SMOKE_TIMEOUT_MS=30000
LIVE_SMOKE_EMAIL=
LIVE_SMOKE_PASSWORD=
LIVE_SMOKE_ACCESS_TOKEN=
SMOKE_ACCOUNT_ENABLED=false
SMOKE_ACCOUNT_EMAIL=
SMOKE_ACCOUNT_PASSWORD=
SMOKE_ACCOUNT_NICKNAME=TailTalkSmoke
SMOKE_ACCOUNT_RESET_PASSWORD=true
SMOKE_ACCOUNT_ACTION=

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MAX=20
VIEW_RATE_LIMIT_MAX=120
TOUR_API_RATE_LIMIT_MAX=60
AGENT_RATE_LIMIT_MAX=40

# Upload cleanup
UPLOAD_STORAGE_DRIVER=local
UPLOAD_LOCAL_ROOT=uploads
UPLOAD_LOCAL_ROOT_IS_PERSISTENT=false
UPLOAD_PUBLIC_PREFIX=/uploads
ALLOW_LOCAL_UPLOADS_IN_PRODUCTION=false
POST_IMAGE_ORPHAN_MAX_AGE_HOURS=24
POST_IMAGE_ORPHAN_CLEANUP_INTERVAL_MINUTES=60
