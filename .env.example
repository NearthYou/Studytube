WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://app:app@localhost:5432/app_dev
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-random-production-password
POSTGRES_DB=app_dev
AUTH_VERIFICATION_PEPPER=replace-with-a-random-production-secret
AUTH_RATE_LIMIT_PEPPER=replace-with-a-different-random-production-secret
AUTH_MINIMUM_RESPONSE_MS=250
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_TRUST_PROXY_ONE_HOP=false

AI_SERVICE_URL=http://127.0.0.1:8000
AI_SUMMARY_TIMEOUT_MS=180000
INTERNAL_AI_API_KEY=change-me

OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
YOUTUBE_API_KEY=
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=
YOUTUBE_PROXY_URL=
YOUTUBE_AUTO_SUBTITLE_PO_TOKEN=true
YOUTUBE_BGUTIL_SERVER_HOME=.tools/bgutil-ytdlp-pot-provider/server
YT_DLP_FETCH_PO_TOKEN=always
YT_DLP_JS_RUNTIME=

# Production edge. Set the site address to a DNS name for Caddy-managed HTTPS.
STUDYTUBE_SITE_ADDRESS=studytube.example.com
STUDYTUBE_PUBLIC_URL=https://studytube.example.com
