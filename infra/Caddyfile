{$STUDYTUBE_SITE_ADDRESS} {
    encode zstd gzip

    log {
        output stdout
        format console
    }

    header {
        -Server
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Content-Type-Options "nosniff"
    }

    handle_path /api/* {
        reverse_proxy 127.0.0.1:3000 {
            transport http {
                dial_timeout 2s
                response_header_timeout 185s
            }
        }
    }

    handle {
        root * /var/www/studytube/current

        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"

        @documents not path /assets/*
        header @documents Cache-Control "no-store"

        try_files {path} /index.html
        file_server
    }
}
