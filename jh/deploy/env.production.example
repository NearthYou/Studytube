# Copy this file to .env.production on the EC2 host and fill real values there.
# Do not commit .env.production.

NODE_ENV=production

# Frontend build
# Empty means the Vite app calls the same origin, e.g. /api through nginx.
VITE_API_BASE_URL=
VITE_KAKAO_MAP_JS_KEY=
VITE_ENABLED_SOCIAL_PROVIDERS=kakao

# Backend
PORT=3000
DATABASE_URL=postgres://tailtalk:CHANGE_ME@tailtalk-prod-db.xxxxxx.ap-northeast-2.rds.amazonaws.com:5432/tailtalk
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_RANDOM
JWT_EXPIRES_IN_SECONDS=3600
FRONTEND_ORIGINS=https://pongki.shop,https://www.pongki.shop
BACKEND_PUBLIC_URL=https://pongki.shop
FRONTEND_URL=https://pongki.shop

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Tail Talk <noreply@pongki.shop>"

# Social auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
SOCIAL_AUTH_BACKEND_URL=https://pongki.shop
SOCIAL_AUTH_FRONTEND_URL=https://pongki.shop
SOCIAL_AUTH_TIMEOUT_MS=10000

# TourAPI / Pet places
TOUR_API_SERVICE_KEY=CHANGE_ME
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorPetTourService2
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=TailTalk
TOUR_API_TIMEOUT_MS=10000

# Assistant / AI worker
AI_SERVICE_URL=http://ai:8000
AI_SERVICE_TIMEOUT_MS=30000
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-5.5

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MAX=20
VIEW_RATE_LIMIT_MAX=120
TOUR_API_RATE_LIMIT_MAX=60
AGENT_RATE_LIMIT_MAX=40

# Upload storage
UPLOAD_STORAGE_DRIVER=local
UPLOAD_LOCAL_ROOT=/app/uploads
UPLOAD_LOCAL_ROOT_IS_PERSISTENT=true
UPLOAD_PUBLIC_PREFIX=/uploads
ALLOW_LOCAL_UPLOADS_IN_PRODUCTION=false
POST_IMAGE_ORPHAN_MAX_AGE_HOURS=24
POST_IMAGE_ORPHAN_CLEANUP_INTERVAL_MINUTES=60
