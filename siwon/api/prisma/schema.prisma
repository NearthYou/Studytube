datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  createdAt    DateTime   @default(now()) @map("created_at")
  posts        Post[]
  comments     Comment[]
  sessions     Session[]
  playlists    Playlist[]
  feedback     PlaylistFeedback[]

  @@map("users")
}

model Session {
  token     String   @id
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Post {
  id              Int            @id @default(autoincrement())
  authorId        Int            @map("author_id")
  title           String
  videoUrl        String         @map("video_url")
  thumbnailUrl    String         @map("thumbnail_url")
  channelName     String         @map("channel_name")
  summary         String
  translatedNotes String         @map("translated_notes")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @map("updated_at")
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments        Comment[]
  tags            PostTag[]
  playlistItems   PlaylistItem[]
  embedding       PostEmbedding?

  @@map("posts")
}

model Tag {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId Int  @map("post_id")
  tagId  Int  @map("tag_id")
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  authorId  Int      @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Playlist {
  id          Int                @id @default(autoincrement())
  ownerId     Int                @map("owner_id")
  title       String
  description String             @default("")
  createdAt   DateTime           @default(now()) @map("created_at")
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items       PlaylistItem[]
  feedback    PlaylistFeedback[]

  @@map("playlists")
}

model PlaylistItem {
  playlistId Int      @map("playlist_id")
  postId     Int      @map("post_id")
  position   Int      @default(0)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([playlistId, postId])
  @@map("playlist_items")
}

model PlaylistFeedback {
  id         Int      @id @default(autoincrement())
  playlistId Int      @map("playlist_id")
  authorId   Int      @map("author_id")
  rating     Int
  body       String
  createdAt  DateTime @default(now()) @map("created_at")
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("playlist_feedback")
}

model PostEmbedding {
  postId    Int      @id @map("post_id")
  content   String
  embedding Unsupported("vector(64)")
  updatedAt DateTime @default(now()) @map("updated_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_embeddings")
}
