PORT=3000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://app:app@localhost:5432/app_dev
VALKEY_URL=redis://127.0.0.1:6379
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_PUBLISH_TIMEOUT_MS=20000
DB_INIT_ATTEMPTS=15
DB_INIT_RETRY_DELAY_MS=1000
# Production requires one explicit writer authority: legacy, freeze, or course.
COURSE_CUTOVER_MODE=legacy
# Local development only. Production requires /var/lib/studytube/course-cutover.
COURSE_CUTOVER_STATE_DIR=.studytube-deploy-state
# Local development only. Production requires /var/lib/studytube/migration-backup/verified-backup.
IRREVERSIBLE_MIGRATIONS_VERIFIED_BACKUP_MARKER=.studytube-deploy-state/verified-backup
AI_SERVICE_URL=http://127.0.0.1:8000
AI_CAPTION_TIMEOUT_MS=300000
AI_TRANSCRIPTION_TIMEOUT_MS=300000
AI_SUMMARY_TIMEOUT_MS=180000
AI_GLOBAL_DAILY_AUDIO_SECONDS=1800
AI_USER_DAILY_AUDIO_SECONDS=1200
AI_MAX_CONCURRENT_WORKS=2
AI_MAX_CONCURRENT_WORKS_PER_USER=1
AI_ESTIMATED_MICROUNITS_PER_AUDIO_SECOND=50
AI_GLOBAL_DAILY_COST_MICROUNITS=90000
AI_GLOBAL_MONTHLY_COST_MICROUNITS=1000000
INTERNAL_AI_API_KEY=change-me
AUTH_VERIFICATION_PEPPER=replace-with-a-random-production-secret
AUTH_RATE_LIMIT_PEPPER=replace-with-a-different-random-production-secret
AUTH_MINIMUM_RESPONSE_MS=250
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_TRUST_PROXY_ONE_HOP=false
AUTH_MODE=google_only
STUDYTUBE_PUBLIC_URL=http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=replace-with-a-google-web-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-a-google-web-client-secret
# Generate exactly 32 random bytes and encode them as base64.
GOOGLE_AUTH_ATTEMPT_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
