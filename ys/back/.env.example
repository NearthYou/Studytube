PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/travel_app
JWT_SECRET=change-this-local-secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_MAX_AGE_MS=604800000
EMAIL_VERIFICATION_SECRET=change-this-local-email-verification-secret
EMAIL_VERIFICATION_MOCK_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_BACK_BASE_URL=http://127.0.0.1:8000
RAG_SYNC_ENABLED=true
INTERNAL_API_TOKEN=change-this-local-internal-token
AI_SYNC_TIMEOUT_MS=5000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
TRUST_PROXY=false
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CHECK_MAX=60
RATE_LIMIT_VIEW_MAX=60
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_DEFAULT_MAX=300
