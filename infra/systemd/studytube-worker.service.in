[Unit]
Description=StudyTube durable work processor
After=network-online.target docker.service studytube-deploy-resume.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@WORKER_USER@
Group=@WORKER_USER@
SupplementaryGroups=@RUNTIME_GROUP@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@RUNTIME_CONFIG_DIR@/worker.env
ExecStart=/usr/bin/env NODE_ENV=production COURSE_CUTOVER_MODE=@COURSE_CUTOVER_MODE@ @NODE_BIN@ api/dist/src/worker.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
