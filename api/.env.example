PORT=3000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://app:app@localhost:5432/app_dev
VALKEY_URL=redis://127.0.0.1:6379
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_PUBLISH_TIMEOUT_MS=20000
DB_INIT_ATTEMPTS=15
DB_INIT_RETRY_DELAY_MS=1000
# Production requires one explicit writer authority: legacy, freeze, or course.
COURSE_CUTOVER_MODE=legacy
# Keep this directory durable across deployments. It contains no secrets.
COURSE_CUTOVER_STATE_DIR=.studytube-deploy-state
# Required only while an irreversible migration is pending. The marker is created after a backup restore rehearsal.
IRREVERSIBLE_MIGRATIONS_VERIFIED_BACKUP_MARKER=.studytube-deploy-state/verified-backup
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SUMMARY_TIMEOUT_MS=180000
INTERNAL_AI_API_KEY=change-me
AUTH_VERIFICATION_PEPPER=replace-with-a-random-production-secret
AUTH_RATE_LIMIT_PEPPER=replace-with-a-different-random-production-secret
AUTH_MINIMUM_RESPONSE_MS=250
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_TRUST_PROXY_ONE_HOP=false
# Use capture locally. Production must use ses with an HTTPS WEB_ORIGIN.
AUTH_EMAIL_PROVIDER=capture
AUTH_EMAIL_SENDER=no-reply@studytube.local
AUTH_EMAIL_CAPTURE_DIR=api/.captures/verification-emails
AUTH_EMAIL_AWS_REGION=ap-northeast-2
AUTH_EMAIL_SES_CONFIGURATION_SET=studytube-transactional
AUTH_EMAIL_POLL_INTERVAL_MS=1000
AUTH_EMAIL_LEASE_MS=30000
AUTH_EMAIL_SEND_TIMEOUT_MS=10000
AUTH_EMAIL_MAX_ATTEMPTS=5
AUTH_EMAIL_RETRY_BASE_MS=1000
AUTH_EMAIL_RETRY_MAX_MS=60000
