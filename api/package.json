{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:worker": "node dist/src/worker",
    "db:migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language cjs",
    "db:migrate:up": "node-pg-migrate up --migrations-dir migrations",
    "db:migrate:down": "node-pg-migrate down --migrations-dir migrations",
    "db:migrate:redo": "node-pg-migrate redo --migrations-dir migrations",
    "db:migrate:status": "node-pg-migrate up --dry-run --migrations-dir migrations",
    "db:migrate:setup-legacy-fixture": "ts-node scripts/setup-legacy-fixture.ts",
    "db:migrate:test-adoption": "ts-node scripts/verify-migration-adoption.ts",
    "db:course:backfill": "ts-node scripts/backfill-courses.ts",
    "db:course:verify": "ts-node scripts/verify-course-backfill.ts",
    "db:seed": "ts-node scripts/seed-demo.ts",
    "db:seed:verify": "ts-node scripts/verify-demo-seed.ts",
    "auth:benchmark-password": "ts-node scripts/benchmark-password-hash.ts",
    "auth:verify-boundary": "ts-node scripts/verify-auth-boundary.ts",
    "work:replay-dead-letter": "ts-node scripts/replay-dead-letter.ts",
    "retrieval:evaluate": "ts-node scripts/evaluate-retrieval.ts",
    "db:verify-runtime-boundary": "ts-node scripts/verify-runtime-database-boundary.ts",
    "db:verify-query-plans": "ts-node scripts/verify-query-plans.ts",
    "openapi:export": "nest build && node dist/scripts/export-openapi.js",
    "openapi:verify": "ts-node scripts/verify-openapi-compatibility.ts",
    "lint": "eslint \"{src,scripts,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1097.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.67.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@smithy/credential-provider-imds": "4.4.15",
    "axios": "^1.18.1",
    "bullmq": "^5.81.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.3.0"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
